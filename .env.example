# Copy values into .env for local development; never commit real credentials.
GEMINI_API_KEY=
PINECONE_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Both webhook and worker must use the same database on local persistent disk.
WHATSAPP_DB_PATH=connect_whatsapp/data/messages.sqlite3
WHATSAPP_GRAPH_VERSION=v21.0
PINECONE_INDEX=coffee-menu
PINECONE_NAMESPACE=
MENU_FILE=structure.json
CHATBOT_TOP_K=15
GEMINI_MODEL=gemini-3.5-flash-lite
SHOP_POLICIES_FILE=generate_prompt/shop_policies.json
