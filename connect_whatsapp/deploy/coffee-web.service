[Unit]
Description=Coffee assistant WhatsApp webhook
After=network-online.target
Wants=network-online.target

[Service]
User=coffee
Group=coffee
WorkingDirectory=/opt/coffee-assistant
EnvironmentFile=/etc/coffee-assistant.env
StateDirectory=coffee-assistant
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/coffee-assistant/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 connect_whatsapp.whatsapp_server:make_app()
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/coffee-assistant

[Install]
WantedBy=multi-user.target
